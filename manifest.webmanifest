{
  "id": "./",
  "name": "Sprint Repeat Log",
  "short_name": "Sprints",
  "description": "Offline repeat-sprint interval log: fixed-effort repeats, timed recovery, fade tracking and printable A4 reports.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["health", "fitness", "sports", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Start interval timer", "short_name": "Timer", "url": "./#timer",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
